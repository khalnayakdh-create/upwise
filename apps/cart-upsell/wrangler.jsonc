{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "upwise-cart-upsell",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Production URL. Cloudflare creates the DNS record and certificate on deploy.
  // workers.dev stays on as a fallback/health-check URL.
  "routes": [{ "pattern": "cart.storevine.app", "custom_domain": true }],
  "workers_dev": true,
  "upload_source_maps": true,
  "vars": {
    // Public values. The API secret is NOT here: set it as an encrypted
    // secret named SHOPIFY_API_SECRET in the Cloudflare dashboard.
    "SHOPIFY_API_KEY": "3e6e2d418655b16b1d9132a533b68a00",
    "SHOPIFY_APP_URL": "https://cart.storevine.app",
    "SCOPES": "read_products,write_discounts",
    // "true" = Shopify test charges (dev store). Set "false" for production.
    "BILLING_TEST_MODE": "true",
    // DEV ONLY: lets the dev store test paid features. Empty this before launch.
    "DEV_PLAN_OVERRIDES": "upwisedev.myshopify.com:pro"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id: Wrangler provisions the database on first deploy.
      // Tables are created by the Worker itself (see @upwise/platform migrations).
      "database_name": "upwise-cart-upsell"
    }
  ],
  // Daily health check (UTC); alerts go out via Cloudflare Email Service from alerts@storevine.app.
  "triggers": { "crons": ["11 15 * * *"] },
  "send_email": [{ "name": "EMAIL" }]
}
