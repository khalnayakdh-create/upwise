{%- comment -%}
  App embed: loads the Storevine cart widget on every page so it can render
  inside the cart drawer and on the cart page. Offer data comes from an
  app-owned metafield written by the Storevine admin (no backend call needed).
{%- endcomment -%}
{%- assign storevine_config = app.metafields.storevine_cart.config -%}
{%- if storevine_config != blank -%}
  <script type="application/json" id="storevine-cart-config">{{ storevine_config.value | json }}</script>
  <script>
    window.StorevineCart = window.StorevineCart || {};
    window.StorevineCart.settings = {
      drawer: {{ block.settings.show_in_drawer | json }},
      cartPage: {{ block.settings.show_on_cart_page | json }},
      buttonLabel: {{ block.settings.button_label | json }},
      maxProducts: {{ block.settings.max_products | json }}
    };
    window.StorevineCart.strings = {
      retry: {{ 'cart_offers.retry' | t | json }},
      percentOff: {{ 'cart_offers.percent_off' | t: percent: '%p' | json }},
      wasNow: {{ 'cart_offers.was_now' | t: was: '%w', now: '%n' | json }},
      addItem: {{ 'cart_offers.add_item' | t: title: '%t' | json }}
    };
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Storevine cart offers",
  "target": "body",
  "javascript": "storevine-cart.js",
  "stylesheet": "storevine-cart.css",
  "settings": [
    { "type": "checkbox", "id": "show_in_drawer", "label": "Show in cart drawer", "default": true },
    { "type": "checkbox", "id": "show_on_cart_page", "label": "Show on cart page", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add" },
    { "type": "range", "id": "max_products", "label": "Products to show", "min": 1, "max": 3, "step": 1, "default": 3 }
  ]
}
{% endschema %}
