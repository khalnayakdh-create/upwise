{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "upwise-reviews",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "routes": [{ "pattern": "reviews.storevine.app", "custom_domain": true }],
  "workers_dev": true,
  "vars": {
    // Public values. SHOPIFY_API_SECRET is an encrypted secret set in Cloudflare.
    "SHOPIFY_API_KEY": "32a320dfc76c417d383e39d124f8405c",
    "SHOPIFY_APP_URL": "https://reviews.storevine.app",
    "SCOPES": "read_products,write_products,read_orders",
    "BILLING_TEST_MODE": "true",
    // DEV ONLY: empty before launch.
    "DEV_PLAN_OVERRIDES": "upwisedev.myshopify.com:growth"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "upwise-reviews" }],
  // Review-request emails: every 15 minutes, send what's due.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Cloudflare Email Service binding — add back once storevine.app is onboarded under
  // Compute > Email Service > Email Sending (deploys fail before that). Until then
  // review requests stay scheduled and nothing is lost:
  //   "send_email": [{ "name": "EMAIL" }]
  // Review photos — add back once R2 is enabled on the account and the bucket exists
  // (R2 buckets are NOT auto-created; deploy fails with code 10085 otherwise).
  // Until then reviews are accepted without photos:
  //   "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "storevine-review-photos" }]
}
