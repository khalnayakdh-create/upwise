{%- comment -%} Upwise Pop-ups: email sign-up pop-up. Settings come from the Upwise admin (app metafield). {%- endcomment -%}
{%- assign upwise_popup = app.metafields.upwise_popups.config.value -%}
{%- if upwise_popup and upwise_popup.enabled -%}
  {%- unless upwise_popup.pages == 'home' and request.page_type != 'index' -%}
    <script type="application/json" id="upwise-popup-config">{{ upwise_popup | json }}</script>
    <script src="{{ 'upwise-popup.js' | asset_url }}" defer></script>
    <link rel="stylesheet" href="{{ 'upwise-popup.css' | asset_url }}" media="print" onload="this.media='all'">
  {%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "Upwise pop-up",
  "target": "body",
  "settings": []
}
{% endschema %}
