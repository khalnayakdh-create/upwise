{%- comment -%} Storevine Pop-ups: email sign-up pop-up. Settings come from the Storevine admin (app metafield). {%- endcomment -%}
{%- assign storevine_popup = app.metafields.storevine_popups.config.value -%}
{%- assign storevine_hide = false -%}
{%- if customer -%}
  {%- comment -%} Signed-in shoppers: hidden by default; optionally shown only to those not yet subscribed. {%- endcomment -%}
  {%- if storevine_popup.signedIn == 'unsubscribed' -%}
    {%- if customer.accepts_marketing -%}{%- assign storevine_hide = true -%}{%- endif -%}
  {%- else -%}
    {%- assign storevine_hide = true -%}
  {%- endif -%}
{%- endif -%}
{%- if storevine_popup and storevine_popup.enabled and storevine_hide == false -%}
  {%- unless storevine_popup.pages == 'home' and request.page_type != 'index' -%}
    {%- if customer -%}
      <script type="application/json" id="storevine-popup-customer">{"email": {{ customer.email | json }}}</script>
    {%- endif -%}
    <script type="application/json" id="storevine-popup-config">{{ storevine_popup | json }}</script>
    <script type="application/json" id="storevine-popup-strings">
      {
        "emailLabel": {{ 'popup.email_label' | t | json }},
        "close": {{ 'popup.close' | t | json }},
        "consentRequired": {{ 'popup.consent_required' | t | json }},
        "invalidEmail": {{ 'popup.invalid_email' | t | json }},
        "error": {{ 'popup.error' | t | json }},
        "poweredBy": {{ 'popup.powered_by' | t | json }},
        "codeLabel": {{ 'popup.code_label' | t | json }}
      }
    </script>
    <script src="{{ 'storevine-popup.js' | asset_url }}" defer></script>
    <link rel="stylesheet" href="{{ 'storevine-popup.css' | asset_url }}" media="print" onload="this.media='all'">
  {%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "Storevine pop-up",
  "target": "body",
  "settings": []
}
{% endschema %}
