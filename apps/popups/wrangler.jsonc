{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "upwise-popups",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "routes": [{ "pattern": "popups.storevine.app", "custom_domain": true }],
  "workers_dev": true,
  "vars": {
    // Public values. SHOPIFY_API_SECRET is an encrypted secret set in Cloudflare.
    "SHOPIFY_API_KEY": "6b1ae04f6ae8a893a38a2fe7b8d4da8b",
    "SHOPIFY_APP_URL": "https://popups.storevine.app",
    "SCOPES": "read_customers,write_customers,write_discounts",
    "BILLING_TEST_MODE": "true",
    // DEV ONLY: empty before launch.
    "DEV_PLAN_OVERRIDES": "upwisedev.myshopify.com:growth"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "upwise-popups" }],
  // Daily health check (UTC); alerts go out via Cloudflare Email Service from alerts@storevine.app.
  // Bot shield: sign-ups per shopper IP and per store (namespace ids are account-unique).
  "ratelimits": [
    { "name": "SIGNUP_IP", "namespace_id": "1101", "simple": { "limit": 5, "period": 60 } },
    { "name": "SIGNUP_SHOP", "namespace_id": "1102", "simple": { "limit": 120, "period": 60 } }
  ],
  "triggers": { "crons": ["11 15 * * *"] },
  "send_email": [{ "name": "EMAIL" }],
  // Staging: separate Shopify app, Worker, database and domain for testing, so test data never
  // touches production. Build with CLOUDFLARE_ENV=staging (see .github/workflows/staging.yml).
  "env": {
    "staging": {
      "name": "upwise-popups-staging",
      "routes": [{ "pattern": "popups-staging.storevine.app", "custom_domain": true }],
      "vars": {
        "SHOPIFY_API_KEY": "237ad81936da19c78dc04f5e2765cc45",
        "SHOPIFY_APP_URL": "https://popups-staging.storevine.app",
        "SCOPES": "read_customers,write_customers,write_discounts",
        "BILLING_TEST_MODE": "true",
        // Staging stays on test billing; paid features unlocked for the staging store.
        "DEV_PLAN_OVERRIDES": "dhyanmart-i9ehpjgq.myshopify.com:growth"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "upwise-popups-staging" }],
      "triggers": { "crons": ["11 15 * * *"] },
      "send_email": [{ "name": "EMAIL" }],
      "ratelimits": [
        { "name": "SIGNUP_IP", "namespace_id": "2101", "simple": { "limit": 5, "period": 60 } },
        { "name": "SIGNUP_SHOP", "namespace_id": "2102", "simple": { "limit": 120, "period": 60 } }
      ]
    }
  }
}
