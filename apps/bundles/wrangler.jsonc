{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "upwise-bundles",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "routes": [{ "pattern": "bundles.storevine.app", "custom_domain": true }],
  "workers_dev": true,
  "vars": {
    // Public values. SHOPIFY_API_SECRET is an encrypted secret set in Cloudflare.
    "SHOPIFY_API_KEY": "d1c8b13293b07718447b5f039c8e455a",
    "SHOPIFY_APP_URL": "https://bundles.storevine.app",
    "SCOPES": "read_products,write_discounts,read_orders",
    "BILLING_TEST_MODE": "true",
    // DEV ONLY: empty before launch.
    "DEV_PLAN_OVERRIDES": "upwisedev.myshopify.com:growth"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "upwise-bundles" }],
  // Daily health check (UTC); alerts go out via Cloudflare Email Service from alerts@storevine.app.
  "triggers": { "crons": ["11 15 * * *"] },
  "send_email": [{ "name": "EMAIL" }],
  // Staging: separate Shopify app, Worker, database and domain for testing, so test data never
  // touches production. Build with CLOUDFLARE_ENV=staging (see .github/workflows/staging.yml).
  "env": {
    "staging": {
      "name": "upwise-bundles-staging",
      "routes": [{ "pattern": "bundles-staging.storevine.app", "custom_domain": true }],
      "vars": {
        "SHOPIFY_API_KEY": "f40e2458703c5ecd7daaf4934c3ae3c2",
        "SHOPIFY_APP_URL": "https://bundles-staging.storevine.app",
        "SCOPES": "read_products,write_discounts,read_orders",
        "BILLING_TEST_MODE": "true",
        // Staging stays on test billing; paid features unlocked for the staging store.
        "DEV_PLAN_OVERRIDES": "dhyanmart-i9ehpjgq.myshopify.com:growth"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "upwise-bundles-staging" }],
      "triggers": { "crons": ["11 15 * * *"] },
      "send_email": [{ "name": "EMAIL" }]
    }
  }
}
