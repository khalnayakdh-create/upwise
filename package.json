{
  "name": "upwise",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "allowScripts": {
    "workerd": true,
    "esbuild": true
  }
}
